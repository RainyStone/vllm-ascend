+++ b/tests/utils_/test_async_tokenizer_window.py
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import asyncio
+
+import pytest
+from transformers.tokenization_utils_base import BatchEncoding
+
+from vllm import envs
+from vllm.utils.async_utils import AsyncMicrobatchTokenizer
+
+
+class RecordingTokenizer:
+    model_max_length = 1024
+
+    def __init__(self):
+        self.batches = []
+
+    def __call__(self, prompts, **kwargs):
+        batched = isinstance(prompts, list)
+        texts = prompts if batched else [prompts]
+        self.batches.append(list(texts))
+        ids = [[ord(c) for c in text] for text in texts]
+        return BatchEncoding({"input_ids": ids if batched else ids[0]})
+
+    def batch_decode(self, sequences):
+        return ["".join(chr(c) for c in ids) for ids in sequences]
+
+
+async def close(tokenizer):
+    for task in tokenizer._batcher_tasks:
+        task.cancel()
+    await asyncio.gather(*tokenizer._batcher_tasks, return_exceptions=True)
+    tokenizer._executor.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_window_coalesces_staggered_burst(monkeypatch):
+    monkeypatch.setattr(envs, "VLLM_TOKENIZER_BATCH_WAIT_MS", 20.0)
+    backend = RecordingTokenizer()
+    tokenizer = AsyncMicrobatchTokenizer(backend)
+
+    async def encode_after(delay, prompt):
+        await asyncio.sleep(delay)
+        return await tokenizer.encode(prompt)
+
+    try:
+        results = await asyncio.wait_for(
+            asyncio.gather(
+                *(
+                    encode_after(i * 0.002, text)
+                    for i, text in enumerate(["ab", "cd", "ef", "gh"])
+                )
+            ),
+            timeout=1,
+        )
+        assert results == [[97, 98], [99, 100], [101, 102], [103, 104]]
+        assert backend.batches == [["ab", "cd", "ef", "gh"]]
+    finally:
+        await close(tokenizer)
+
+
+@pytest.mark.asyncio
+async def test_single_request_and_decode_are_bounded(monkeypatch):
+    monkeypatch.setattr(envs, "VLLM_TOKENIZER_BATCH_WAIT_MS", 20.0)
+    tokenizer = AsyncMicrobatchTokenizer(RecordingTokenizer())
+    try:
+        assert await asyncio.wait_for(tokenizer.encode("abc"), 1) == [97, 98, 99]
+        assert await asyncio.wait_for(tokenizer.decode([97, 98]), 1) == "ab"
+    finally:
+        await close(tokenizer)
+
+
+@pytest.mark.asyncio
+async def test_explicit_zero_overrides_environment(monkeypatch):
+    monkeypatch.setattr(envs, "VLLM_TOKENIZER_BATCH_WAIT_MS", 20.0)
+    tokenizer = AsyncMicrobatchTokenizer(RecordingTokenizer(), batch_wait_timeout_s=0)
+    try:
+        assert tokenizer.batch_wait_timeout_s == 0
+        assert await asyncio.wait_for(tokenizer.encode("x"), 1) == [120]
+    finally:
+        await close(tokenizer)
+
+
+@pytest.mark.asyncio
+async def test_cancelled_request_does_not_lose_other_results(monkeypatch):
+    monkeypatch.setattr(envs, "VLLM_TOKENIZER_BATCH_WAIT_MS", 20.0)
+    tokenizer = AsyncMicrobatchTokenizer(RecordingTokenizer())
+    try:
+        cancelled = asyncio.create_task(tokenizer.encode("a"))
+        survivor = asyncio.create_task(tokenizer.encode("b"))
+        await asyncio.sleep(0.001)
+        cancelled.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await cancelled
+        assert await asyncio.wait_for(survivor, 1) == [98]
+    finally:
+        await close(tokenizer)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("value", [-1.0, float("nan"), float("inf")])
+async def test_invalid_window_rejected(monkeypatch, value):
+    monkeypatch.setattr(envs, "VLLM_TOKENIZER_BATCH_WAIT_MS", value)
+    with pytest.raises(ValueError, match="finite and non-negative"):
+        AsyncMicrobatchTokenizer(RecordingTokenizer())
